# RabbitMQ
RABBITMQ_DEFAULT_USER=gophprofile
RABBITMQ_DEFAULT_PASS=gophprofile
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# Проброс портов RabbitMQ на хост (если 5672/15672 заняты — смените здесь)
RABBITMQ_PUBLISH_PORT=5673
RABBITMQ_MANAGEMENT_PUBLISH_PORT=15673

# MinIO
MINIO_ROOT_USER=gophprofile
MINIO_ROOT_PASSWORD=gophprofile
MINIO_ACCESS_KEY=gophprofile
MINIO_SECRET_KEY=gophprofile
MINIO_BUCKET_NAME=gophprofile
MINIO_USE_SSL=false
MINIO_ENDPOINT=minio:9000
# Проброс портов MinIO на хост (если 9000/9001 заняты)
MINIO_API_PUBLISH_PORT=9002
MINIO_CONSOLE_PUBLISH_PORT=9003

# Build
TARGETOS=linux
TARGETARCH=amd64
GO_SERVER_MAIN_PATH=./cmd/server
GO_WORKER_MAIN_PATH=./cmd/worker
GIT_COMMIT=d154068
BUILD_DATE=2026-05-12
BUILD_VERSION=1.0.0

# Database
DATABASE_DSN=host=postgres port=5432 user=gophprofile password=gophprofile dbname=gophprofile sslmode=disable
RUN_MIGRATIONS=false

# Server
HOST=0.0.0.0
PORT=8080
MAX_FILE_SIZE=1024000
SECRET_KEY=

# Client (nginx)
CLIENT_MAX_BODY_SIZE=10m

# Observability
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
OTEL_SERVICE_NAME=gophprofile-server
METRICS_ADDR=:9090
LOG_FORMAT=json
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# В Docker по умолчанию /tmp/audit.json (запись от appuser; не использовать audit.json в /app из‑за тома).
AUDIT_FILE=/tmp/audit.json

# Локально не задаём: в Docker-образах server и worker выставлен MIGRATIONS_PATH к каталогу внутри образа.
# MIGRATIONS_PATH=/custom/path/to/migrations